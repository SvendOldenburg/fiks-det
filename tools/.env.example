# Copy to tools/.env and fill in. Never commit tools/.env.
PB_URL=https://pb.aetheriumforge.cloud

# PocketBase superuser -- needed to create the collection and set its rules.
# There is no app-level account: fiksdet_tasks has no login, so no
# FIKSDET_USER_* pair is needed here (unlike anvil/vessel's tools/.env).
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
